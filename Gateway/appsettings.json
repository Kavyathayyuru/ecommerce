{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "Issuer": "ECommerceMicroservices",
    "Audience": "ECommerceMicroservices"
  },
  "Monitoring": {
    "ProductServiceUrl": "http://localhost:5012",
    "OrderServiceUrl": "http://localhost:5080",
    "UserServiceUrl": "http://localhost:5078",
    "PaymentServiceUrl": "http://localhost:5022"
  },
  "AllowedHosts": "*",
  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "product-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/product/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/product" }
        ]
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/order/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/order" }
        ]
      },
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/user/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/user" }
        ]
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/payment" }
        ]
      }
    },
    "Clusters": {
      "product-cluster": {
        "Destinations": {
          "product": { "Address": "http://localhost:5012/" }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order": { "Address": "http://localhost:5080/" }
        }
      },
      "user-cluster": {
        "Destinations": {
          "user": { "Address": "http://localhost:5078/" }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment": { "Address": "http://localhost:5022/" }
        }
      }
    }
  }
}
