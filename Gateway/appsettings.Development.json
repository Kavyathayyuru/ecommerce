{
  "Authentication": {
    "Issuer": "ECommerceMicroservices",
    "Audience": "ECommerceMicroservices",
    "SigningKey": "local-development-only-signing-key-change-me-32"
  },
  "ReverseProxy": {
    "Routes": {
      "order-hub-route": {
        "ClusterId": "order-cluster",
        "Match": { "Path": "/hubs/orders/{**catch-all}" }
      }
    }
  }
}
